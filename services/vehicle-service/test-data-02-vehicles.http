### BennyCar Vehicle Service - Create Vehicles
### Base URL
@baseUrl = http://localhost:8082/api/v1

### IMPORTANT: Replace these with actual IDs from test-data-01-brands-types.http responses
@bmwId = REPLACE_WITH_BMW_ID
@mercedesId = REPLACE_WITH_MERCEDES_ID
@audiId = REPLACE_WITH_AUDI_ID
@porscheId = REPLACE_WITH_PORSCHE_ID
@teslaId = REPLACE_WITH_TESLA_ID
@lamborghiniId = REPLACE_WITH_LAMBORGHINI_ID
@ferrariId = REPLACE_WITH_FERRARI_ID

@sedanId = REPLACE_WITH_SEDAN_ID
@suvId = REPLACE_WITH_SUV_ID
@coupeId = REPLACE_WITH_COUPE_ID
@convertibleId = REPLACE_WITH_CONVERTIBLE_ID
@sportsCarId = REPLACE_WITH_SPORTSCAR_ID
@electricId = REPLACE_WITH_ELECTRIC_ID

### ============================================================================
### BMW Vehicles
### ============================================================================

### Create BMW 3 Series
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "brandId": "{{bmwId}}",
  "vehicleTypeId": "{{sedanId}}",
  "model": "3 Series 330i",
  "modelYear": 2024,
  "description": "The BMW 3 Series is a compact executive sedan that perfectly balances sportiness and luxury. With its iconic kidney grille and dynamic design, it offers an engaging driving experience combined with premium comfort and cutting-edge technology.",
  "basePrice": 45000.00,
  "engine": "2.0L 4-cylinder Turbo",
  "transmission": "8-speed Automatic",
  "fuelType": "Petrol",
  "horsepower": "255 hp",
  "seatingCapacity": 5,
  "cargoCapacityLiters": 480,
  "fuelEfficiency": "6.5 L/100km",
  "mainImageUrl": "https://images.unsplash.com/photo-1555215695-3004980ad54e?w=1200&h=800&fit=crop",
  "additionalImages": [
    "https://images.unsplash.com/photo-1617531653520-bd466c5d3e44?w=1200&h=800&fit=crop",
    "https://images.unsplash.com/photo-1619405399517-d7fce0f13302?w=1200&h=800&fit=crop"
  ],
  "stockQuantity": 8
}

