# ========================================
SWAGGER_ENABLED=true
# Swagger

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS

ACTUATOR_HEALTH_DETAILS=always
# Actuator Configuration

JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
# Hibernate SQL

LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_ROOT=INFO
# Logging Configuration

JWT_EXPIRATION=86400000
JWT_SECRET=your_secret_key_here_min_32_chars
# JWT Configuration

SPRING_JPA_HIBERNATE_DDL_AUTO=update
# JPA/Hibernate Settings

SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bennycar_db?currentSchema=vehicle_service
# Database Configuration

SERVER_PORT=8082
# Server Configuration

SPRING_PROFILES_ACTIVE=dev
# Spring Profile (dev, prod, test)

# Never commit .env file to git
# Copy this file to .env and fill in your actual values
# ========================================
# BennyCar Vehicle Service - Configuration Template

