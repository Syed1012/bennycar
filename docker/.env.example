# =============================================================================
# BennyCar Docker Environment Configuration
# =============================================================================
# Production environment variables template
# Copy this file to .env and update with your values
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=bennycar_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_PORT=5433

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MQTT Configuration (via RabbitMQ MQTT Plugin)
MQTT_PORT=1883

# SonarQube Configuration
SONARQUBE_PORT=9000

# =============================================================================
# Security Notes:
# =============================================================================
# 1. Use strong passwords (minimum 16 characters, alphanumeric + special chars)
# 2. Never commit .env file to version control
# 3. Rotate passwords regularly
# 4. Use different passwords for each service
# 5. For production, consider using secrets management (Docker Secrets, Vault)
# =============================================================================

