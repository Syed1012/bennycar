# ========================================
# BennyCar Order Service - Configuration Template
# ========================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to git

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8083

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bennycar_db?currentSchema=order_service
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=your_password_here

# JPA/Hibernate Settings
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Configuration
JWT_SECRET=your_secret_key_here_min_32_chars
JWT_EXPIRATION=86400000

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_SQL=DEBUG

# Hibernate SQL
HIBERNATE_FORMAT_SQL=true
JPA_SHOW_SQL=false

# Actuator Configuration
ACTUATOR_HEALTH_DETAILS=always

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Inter-service Communication
VEHICLE_SERVICE_URL=http://localhost:8082

